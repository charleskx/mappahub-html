{
  "name": "MappaHub",
  "short_name": "MappaHub",
  "description": "Visualize sua rede de parceiros no mapa",
  "start_url": "/",
  "display": "browser",
  "background_color": "#F8FAFC",
  "theme_color": "#2563EB",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    }
  ]
}
